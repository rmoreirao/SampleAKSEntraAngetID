# Local compose uses no credentials or secrets.
COMPOSE_PROJECT_NAME=aks-agent-sample

# AKS deployment examples (pass these as script parameters rather than secrets).
IMAGE_TAG=replace-with-git-sha
SEARCH_INDEX=recipes
AUTH_MODE=mixed

# Optional override; Deploy-AksWorkloads.ps1 defaults to the reviewed digest.
AUTH_SDK_IMAGE=mcr.microsoft.com/entra-sdk/auth-sidecar@sha256:05f77ddaf35a0763950d24493044867be9f9a258d113eeff57cecb5cc9cecc78
